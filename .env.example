# Copy to .env and fill in. .env is gitignored; this file is not.

# Jev, via the TypeSafe SDK. Either name works; TYPESAFE_API_KEY is checked first.
TYPESAFE_API_KEY=
JEV_API_KEY=

# The chat models, via OpenRouter (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Where the local models (laya, gliclass) run, such as cpu or cuda. Empty: the model picks.
SOCB_DEVICE=
